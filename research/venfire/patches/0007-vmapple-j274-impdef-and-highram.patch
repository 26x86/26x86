diff --git a/target/arm/helper.c b/target/arm/helper.c
index c3f607e..c6d7122 100644
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -3739,6 +3739,69 @@ static const ARMCPRegInfo v8_cp_reginfo[] = {
       .fieldoffset = offsetoflow32(CPUARMState, cp15.mdcr_el3) },
 };
 
+/* These are present only when EL1 supports AArch32 */
+/*
+ * Apple M1 iBoot uses S3_3_C15_C7_0 during the early L2/DRAM bring-up
+ * sequence.  This encoding is implementation-defined in AArch64; it is not
+ * an architectural register and must not be exposed by the generic CPU.
+ *
+ * The VMApple research machine does not claim to reproduce the physical
+ * register.  It models only the observed contract needed by the j274 iBoot
+ * path: writes are retained and a write with bit 1 set makes the bounded
+ * initialization-complete bit visible.  The CPU property is set by
+ * hw/vmapple only for research-headless TCG, so ordinary ARM guests still
+ * take the architectural undefined-system-register path.
+ */
+#define VMAPPLE_L2_CRAMCONFIG_INIT  BIT_ULL(1)
+#define VMAPPLE_L2_CRAMCONFIG_DONE  BIT_ULL(63)
+#define VMAPPLE_L2_CRAMCONFIG_RESET ((UINT64_C(0x3c) << 16) | \
+                                     (UINT64_C(0x10) << 8))
+
+static uint64_t vmapple_l2_cramconfig_read(CPUARMState *env,
+                                           const ARMCPRegInfo *ri)
+{
+    return env->cp15.vmapple_l2_cramconfig;
+}
+
+static void vmapple_l2_cramconfig_write(CPUARMState *env,
+                                        const ARMCPRegInfo *ri,
+                                        uint64_t value)
+{
+    /* The research model completes the observed one-write initialization. */
+    value |= VMAPPLE_L2_CRAMCONFIG_DONE;
+    env->cp15.vmapple_l2_cramconfig = value;
+}
+
+static void vmapple_l2_cramconfig_reset(CPUARMState *env,
+                                        const ARMCPRegInfo *ri)
+{
+    /* Observed j274 geometry: exponent 16 and limit 0x3c. */
+    env->cp15.vmapple_l2_cramconfig = VMAPPLE_L2_CRAMCONFIG_RESET;
+}
+
+static const ARMCPRegInfo vmapple_impdef_reginfo[] = {
+    {
+        .name = "VMAPPLE_L2_CRAMCONFIG",
+        .state = ARM_CP_STATE_AA64,
+        .opc0 = 3, .opc1 = 3, .crn = 15, .crm = 7, .opc2 = 0,
+        .access = PL1_RW,
+        .type = ARM_CP_IO,
+        .readfn = vmapple_l2_cramconfig_read,
+        .writefn = vmapple_l2_cramconfig_write,
+        .resetfn = vmapple_l2_cramconfig_reset,
+    },
+    {
+        /* Apple access-controlled alias of the physical counter. */
+        .name = "VMAPPLE_ACNTPCTSS_EL0",
+        .state = ARM_CP_STATE_AA64,
+        .opc0 = 3, .opc1 = 4, .crn = 15, .crm = 10, .opc2 = 5,
+        .access = PL2_R,
+        .type = ARM_CP_NO_RAW | ARM_CP_IO,
+        .accessfn = gt_pct_access,
+        .readfn = gt_cnt_read,
+    },
+};
+
 /* These are present only when EL1 supports AArch32 */
 static const ARMCPRegInfo v8_aa32_el1_reginfo[] = {
     { .name = "FPEXC32_EL2", .state = ARM_CP_STATE_AA64,
@@ -6989,6 +7052,9 @@ void register_cp_regs_for_features(ARMCPU *cpu)
         }
         define_arm_cp_regs(cpu, v8_idregs);
         define_arm_cp_regs(cpu, v8_cp_reginfo);
+        if (cpu->vmapple_research) {
+            define_arm_cp_regs(cpu, vmapple_impdef_reginfo);
+        }
         if (cpu_isar_feature(aa64_aa32_el1, cpu)) {
             define_arm_cp_regs(cpu, v8_aa32_el1_reginfo);
         }
