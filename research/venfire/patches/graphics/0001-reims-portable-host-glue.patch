--- a/hw/display/meson.build
+++ b/hw/display/meson.build
@@ -143,3 +143,18 @@
 system_ss.add(when: 'CONFIG_OMAP', if_true: files('omap_lcdc.c'))
 
 modules += { 'hw-display': hw_display_modules }
+
+# Optional Venfire graphics integration. The builder supplies the pinned Rust
+# static library and C ABI header through Meson options, never absolute patches.
+reims_library = get_option('reims_vgpu_library')
+reims_include = get_option('reims_vgpu_include')
+if not fs.is_file(reims_library) or not fs.is_file(reims_include / 'reims_vgpu_qemu_abi.h')
+  error('Reims requires -Dreims_vgpu_library and -Dreims_vgpu_include')
+endif
+reims_dep = declare_dependency(
+  link_args: [reims_library],
+  include_directories: include_directories(reims_include),
+  dependencies: [cc.find_library('m'), cc.find_library('dl'), dependency('threads')])
+system_ss.add(when: 'CONFIG_REIMS_VGPU',
+  if_true: [files('reims-vgpu-mmio.c', 'reims-vgpu-pci.c',
+                 'reims-vgpu-dirty.c', 'reims-vgpu-shim.c'), reims_dep])
