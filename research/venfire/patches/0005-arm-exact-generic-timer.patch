From: Venfire contributors <venfire@example.invalid>
Subject: [PATCH 5] target/arm: preserve exact generic timer frequency

Use matched floor counter and ceil deadline conversions instead of an integer
nanosecond period. Keep counter offsets, checked tick addition and the existing
1GHz effective cap. All seven generic timers and WFx timeout/event deadlines
use nanoseconds. The separate event-stream absolute-count/mask issue is not
changed by this patch. No Apple guest code or authentication is modified.

diff --git a/target/arm/cpu.c b/target/arm/cpu.c
index 77aa78f..13cd16e 100644
--- a/target/arm/cpu.c
+++ b/target/arm/cpu.c
@@ -1427,28 +1427,31 @@ static void aarch64_cpu_set_aarch64(Object *obj, bool value, Error **errp)
     }
 }
 
-unsigned int gt_cntfrq_period_ns(ARMCPU *cpu)
+/*
+ * Keep the existing effective-frequency cap. cntfrq=0 has already been
+ * resolved to the CPU/machine default before these helpers are called.
+ * CNTFRQ_EL0 is a software-visible register, not the clock source.
+ */
+static uint32_t gt_effective_freq_hz(ARMCPU *cpu)
 {
-    /*
-     * The exact approach to calculating guest ticks is:
-     *
-     *     muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), cpu->gt_cntfrq_hz,
-     *              NANOSECONDS_PER_SECOND);
-     *
-     * We don't do that. Rather we intentionally use integer division
-     * truncation below and in the caller for the conversion of host monotonic
-     * time to guest ticks to provide the exact inverse for the semantics of
-     * the QEMUTimer scale factor. QEMUTimer's scale facter is an integer, so
-     * it loses precision when representing frequencies where
-     * `(NANOSECONDS_PER_SECOND % cpu->gt_cntfrq) > 0` holds. Failing to
-     * provide an exact inverse leads to scheduling timers with negative
-     * periods, which in turn leads to sticky behaviour in the guest.
-     *
-     * Finally, CNTFRQ is effectively capped at 1GHz to ensure our scale factor
-     * cannot become zero.
-     */
-    return NANOSECONDS_PER_SECOND > cpu->gt_cntfrq_hz ?
-      NANOSECONDS_PER_SECOND / cpu->gt_cntfrq_hz : 1;
+    return MIN(cpu->gt_cntfrq_hz, NANOSECONDS_PER_SECOND);
+}
+
+uint64_t gt_counter_from_ns(ARMCPU *cpu, uint64_t ns)
+{
+    return muldiv64(ns, gt_effective_freq_hz(cpu), NANOSECONDS_PER_SECOND);
+}
+
+int64_t gt_counter_to_ns(ARMCPU *cpu, uint64_t ticks)
+{
+    uint32_t hz = gt_effective_freq_hz(cpu);
+
+    /* Check before conversion: even the uint64_t result could overflow. */
+    if (ticks > muldiv64(INT64_MAX, hz, NANOSECONDS_PER_SECOND)) {
+        return INT64_MAX;
+    }
+    /* Earliest nanosecond at which floor(ns * hz / 1e9) reaches ticks. */
+    return muldiv64_round_up(ticks, NANOSECONDS_PER_SECOND, hz);
 }
 
 static void arm_cpu_propagate_feature_implications(ARMCPU *cpu)
@@ -1924,21 +1927,19 @@ static void arm_cpu_realizefn(DeviceState *dev, Error **errp)
     }
 #ifndef CONFIG_USER_ONLY
     {
-        uint64_t scale = gt_cntfrq_period_ns(cpu);
-
-        cpu->gt_timer[GTIMER_PHYS] = timer_new(QEMU_CLOCK_VIRTUAL, scale,
+        cpu->gt_timer[GTIMER_PHYS] = timer_new_ns(QEMU_CLOCK_VIRTUAL,
                                                arm_gt_ptimer_cb, cpu);
-        cpu->gt_timer[GTIMER_VIRT] = timer_new(QEMU_CLOCK_VIRTUAL, scale,
+        cpu->gt_timer[GTIMER_VIRT] = timer_new_ns(QEMU_CLOCK_VIRTUAL,
                                                arm_gt_vtimer_cb, cpu);
-        cpu->gt_timer[GTIMER_HYP] = timer_new(QEMU_CLOCK_VIRTUAL, scale,
+        cpu->gt_timer[GTIMER_HYP] = timer_new_ns(QEMU_CLOCK_VIRTUAL,
                                               arm_gt_htimer_cb, cpu);
-        cpu->gt_timer[GTIMER_SEC] = timer_new(QEMU_CLOCK_VIRTUAL, scale,
+        cpu->gt_timer[GTIMER_SEC] = timer_new_ns(QEMU_CLOCK_VIRTUAL,
                                               arm_gt_stimer_cb, cpu);
-        cpu->gt_timer[GTIMER_HYPVIRT] = timer_new(QEMU_CLOCK_VIRTUAL, scale,
+        cpu->gt_timer[GTIMER_HYPVIRT] = timer_new_ns(QEMU_CLOCK_VIRTUAL,
                                                   arm_gt_hvtimer_cb, cpu);
-        cpu->gt_timer[GTIMER_S_EL2_PHYS] = timer_new(QEMU_CLOCK_VIRTUAL, scale,
+        cpu->gt_timer[GTIMER_S_EL2_PHYS] = timer_new_ns(QEMU_CLOCK_VIRTUAL,
                                                      arm_gt_sel2timer_cb, cpu);
-        cpu->gt_timer[GTIMER_S_EL2_VIRT] = timer_new(QEMU_CLOCK_VIRTUAL, scale,
+        cpu->gt_timer[GTIMER_S_EL2_VIRT] = timer_new_ns(QEMU_CLOCK_VIRTUAL,
                                                      arm_gt_sel2vtimer_cb, cpu);
     }
 #endif
diff --git a/target/arm/cpu.h b/target/arm/cpu.h
index e3f931d..a26e28f 100644
--- a/target/arm/cpu.h
+++ b/target/arm/cpu.h
@@ -1215,7 +1215,8 @@ void arm_gt_hvtimer_cb(void *opaque);
 void arm_gt_sel2timer_cb(void *opaque);
 void arm_gt_sel2vtimer_cb(void *opaque);
 
-unsigned int gt_cntfrq_period_ns(ARMCPU *cpu);
+uint64_t gt_counter_from_ns(ARMCPU *cpu, uint64_t ns);
+int64_t gt_counter_to_ns(ARMCPU *cpu, uint64_t ticks);
 void gt_rme_post_el_change(ARMCPU *cpu, void *opaque);
 
 #define ARM_AFF0_SHIFT 0
diff --git a/target/arm/helper.c b/target/arm/helper.c
index c3f607e..f1f6dfc 100644
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -1399,7 +1399,7 @@ uint64_t gt_get_countervalue(CPUARMState *env)
 {
     ARMCPU *cpu = env_archcpu(env);
 
-    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / gt_cntfrq_period_ns(cpu);
+    return gt_counter_from_ns(cpu, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
 }
 
 static void gt_update_gicv5_ppi(CPUARMState *env, int timeridx, bool level)
@@ -1589,11 +1589,7 @@ static void gt_recalc_timer(ARMCPU *cpu, int timeridx)
          * set the timer for as far in the future as possible. When the
          * timer expires we will reset the timer for any remaining period.
          */
-        if (nexttick > INT64_MAX / gt_cntfrq_period_ns(cpu)) {
-            timer_mod_ns(cpu->gt_timer[timeridx], INT64_MAX);
-        } else {
-            timer_mod(cpu->gt_timer[timeridx], nexttick);
-        }
+        timer_mod_ns(cpu->gt_timer[timeridx], gt_counter_to_ns(cpu, nexttick));
         trace_arm_gt_recalc(timeridx, nexttick);
     } else {
         /* Timer disabled: ISTATUS and timer output always clear */
@@ -2378,7 +2374,7 @@ static uint64_t gt_virt_cnt_read(CPUARMState *env, const ARMCPRegInfo *ri)
      * can't call gt_get_countervalue(env), instead we directly
      * call the lower level functions.
      */
-    return cpu_get_clock() / gt_cntfrq_period_ns(cpu);
+    return gt_counter_from_ns(cpu, cpu_get_clock());
 }
 
 static const ARMCPRegInfo generic_timer_cp_reginfo[] = {
diff --git a/target/arm/tcg/op_helper.c b/target/arm/tcg/op_helper.c
index c2b0917..c5bfe3a 100644
--- a/target/arm/tcg/op_helper.c
+++ b/target/arm/tcg/op_helper.c
@@ -451,15 +451,7 @@ void HELPER(wfit)(CPUARMState *env, uint32_t rd)
     if (uadd64_overflow(timeout, offset, &nexttick)) {
         nexttick = UINT64_MAX;
     }
-    if (nexttick > INT64_MAX / gt_cntfrq_period_ns(cpu)) {
-        /*
-         * If the timeout is too long for the signed 64-bit range
-         * of a QEMUTimer, let it expire early.
-         */
-        timer_mod_ns(cpu->wfxt_timer, INT64_MAX);
-    } else {
-        timer_mod(cpu->wfxt_timer, nexttick);
-    }
+    timer_mod_ns(cpu->wfxt_timer, gt_counter_to_ns(cpu, nexttick));
     env->halt_reason = HALT_WFI;
     cs->exception_index = EXCP_HLT;
     cs->halted = 1;
@@ -523,18 +515,14 @@ static int64_t gt_recalc_one_evt(CPUARMState *env, uint32_t control, uint64_t of
         if (uadd64_overflow(next_tick, offset, &abstick)) {
             abstick = UINT64_MAX;
         }
-        if (abstick > INT64_MAX / gt_cntfrq_period_ns(cpu)) {
-            return INT64_MAX;
-        } else {
-            return abstick;
-        }
+        return gt_counter_to_ns(cpu, abstick);
     }
 
     return -1;
 }
 
 /*
- * Calculate the next event stream time and return it. Returns -1 if
+ * Calculate the next event stream time in ns and return it. Returns -1 if
  * no event streams are enabled. It is up to the WFE helpers to decide
  * on the next time.
  */
@@ -625,7 +613,7 @@ void HELPER(wfe)(CPUARMState *env, uint32_t insn_len)
     if (cpu->wfxt_timer) {
         int64_t next_event = gt_calc_next_event_stream(env);
         if (next_event > 0) {
-            timer_mod(cpu->wfxt_timer, next_event);
+            timer_mod_ns(cpu->wfxt_timer, next_event);
         }
     }
 
@@ -708,19 +696,13 @@ void HELPER(wfet)(CPUARMState *env, uint32_t rd)
     if (uadd64_overflow(timeout, offset, &nexttick)) {
         nexttick = UINT64_MAX;
     }
-    if (nexttick > INT64_MAX / gt_cntfrq_period_ns(cpu)) {
-        nexttick = INT64_MAX;
-    }
+    nexttick = gt_counter_to_ns(cpu, nexttick);
 
     next_event = gt_calc_next_event_stream(env);
     if (next_event > 0 && next_event < nexttick) {
-        timer_mod(cpu->wfxt_timer, next_event);
+        timer_mod_ns(cpu->wfxt_timer, next_event);
     } else {
-        if (nexttick == INT64_MAX) {
-            timer_mod_ns(cpu->wfxt_timer, INT64_MAX);
-        } else {
-            timer_mod(cpu->wfxt_timer, nexttick);
-        }
+        timer_mod_ns(cpu->wfxt_timer, nexttick);
     }
 
     env->halt_reason = HALT_WFE;
