 #include "qemu/osdep.h"
+#include "qemu/bswap.h"
 #include "hw/vmapple/vmapple.h"
 #include "hw/core/sysbus.h"
 #include "qemu/log.h"
 #include "qemu/module.h"
 #include "qapi/error.h"
 #include "net/net.h"
+#include "system/address-spaces.h"
+#include "trace.h"
 
 OBJECT_DECLARE_SIMPLE_TYPE(VMAppleCfgState, VMAPPLE_CFG)
 
 #define VMAPPLE_CFG_SIZE 0x00010000
+#define VMAPPLE_OPTIONAL_RPC_SIZE 0x4000
+#define VMAPPLE_OPTIONAL_RPC_DOORBELL 0x3ff8
 
 typedef struct VMAppleCfg {
     uint32_t version;         /* 0x000 */
@@ -60,11 +65,87 @@ struct VMAppleCfgState {
     VMAppleCfg cfg;
 
     MemoryRegion mem;
+    MemoryRegion optional_rpc;
+    bool optional_rpc_unavailable;
+    MemoryRegion *guest_ram;
     char *serial;
     char *model;
     char *soc_name;
 };
 
+/*
+ * Experimental unavailable optional RPC, NOT an implementation of the service.
+ * Original 26A5425a iBEC submits a 24-byte version-1 request at 0x4ffff8.
+ * For opcode 2 it explicitly falls back to the legacy configuration region
+ * when completion byte 3 remains zero. Preserve every guest byte: no success
+ * marker, result, configuration, or signature-related state is synthesized.
+ */
+static MemTxResult vmapple_optional_rpc_write(void *opaque, hwaddr offset,
+                                             uint64_t address, unsigned size,
+                                             MemTxAttrs attrs)
+{
+    VMAppleCfgState *s = VMAPPLE_CFG(opaque);
+    uint8_t header[24];
+    MemoryRegionSection section;
+    bool readable;
+
+    if (offset != VMAPPLE_OPTIONAL_RPC_DOORBELL || size != 8 ||
+        address > UINT64_MAX - sizeof(header)) {
+        trace_vmapple_optional_rpc_reject(offset, address, size, "access");
+        return MEMTX_ERROR;
+    }
+
+    /* Never follow a pointer into MMIO, ROM, a hole, or a partial RAM range. */
+    section = memory_region_find(get_system_memory(), address, sizeof(header));
+    if (!section.mr) {
+        trace_vmapple_optional_rpc_reject(offset, address, size, "unmapped");
+        return MEMTX_ERROR;
+    }
+    readable = section.mr == s->guest_ram &&
+               memory_region_is_ram(section.mr) && !section.readonly &&
+               !memory_region_is_ram_device(section.mr) &&
+               section.offset_within_address_space == address &&
+               int128_eq(section.size, int128_make64(sizeof(header)));
+    if (readable) {
+        memcpy(header, (uint8_t *)memory_region_get_ram_ptr(section.mr) +
+                       section.offset_within_region, sizeof(header));
+    }
+    memory_region_unref(section.mr);
+    if (!readable) {
+        trace_vmapple_optional_rpc_reject(offset, address, size, "not-ram");
+        return MEMTX_ERROR;
+    }
+
+    trace_vmapple_optional_rpc_request(address, ldl_le_p(header),
+                                      ldl_le_p(header + 4),
+                                      ldq_le_p(header + 8),
+                                      ldq_le_p(header + 16));
+    if (ldl_le_p(header) != 0x00010001 || ldl_le_p(header + 4) != 2) {
+        trace_vmapple_optional_rpc_reject(offset, address, size, "unknown-request");
+        return MEMTX_ERROR;
+    }
+
+    /* The bus store completes; the unsupported guest request does not. */
+    return MEMTX_OK;
+}
+
+static MemTxResult vmapple_optional_rpc_read(void *opaque, hwaddr offset,
+                                            uint64_t *value, unsigned size,
+                                            MemTxAttrs attrs)
+{
+    *value = UINT64_MAX;
+    trace_vmapple_optional_rpc_reject(offset, 0, size, "read");
+    return MEMTX_ERROR;
+}
+
+static const MemoryRegionOps vmapple_optional_rpc_ops = {
+    .read_with_attrs = vmapple_optional_rpc_read,
+    .write_with_attrs = vmapple_optional_rpc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 8, .max_access_size = 8 },
+    .impl = { .min_access_size = 8, .max_access_size = 8 },
+};
+
 static void vmapple_cfg_reset(Object *obj, ResetType type)
 {
     VMAppleCfgState *s = VMAPPLE_CFG(obj);
@@ -108,6 +189,12 @@ static void vmapple_cfg_realize(DeviceState *dev, Error **errp)
     VMAppleCfgState *s = VMAPPLE_CFG(dev);
     uint32_t i;
 
+    if (s->optional_rpc_unavailable && !s->guest_ram) {
+        error_setg(errp, "Optional RPC requires the machine guest RAM link");
+        return;
+    }
+    memory_region_set_enabled(&s->optional_rpc, s->optional_rpc_unavailable);
+
     if (!s->serial) {
         s->serial = g_strdup("1234");
     }
@@ -150,9 +237,18 @@ static void vmapple_cfg_init(Object *obj)
     memory_region_init_ram(&s->mem, obj, "VMApple Config", VMAPPLE_CFG_SIZE,
                            &error_fatal);
     sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->mem);
+    memory_region_init_io(&s->optional_rpc, obj, &vmapple_optional_rpc_ops, s,
+                         "vmapple-optional-rpc-unavailable",
+                         VMAPPLE_OPTIONAL_RPC_SIZE);
+    memory_region_set_enabled(&s->optional_rpc, false);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->optional_rpc);
 }
 
 static const Property vmapple_cfg_properties[] = {
+    DEFINE_PROP_BOOL("optional-rpc-unavailable", VMAppleCfgState,
+                     optional_rpc_unavailable, false),
+    DEFINE_PROP_LINK("guest-ram", VMAppleCfgState, guest_ram,
+                     TYPE_MEMORY_REGION, MemoryRegion *),
     DEFINE_PROP_UINT32("nr-cpus", VMAppleCfgState, cfg.nr_cpus, 1),
     DEFINE_PROP_UINT64("ecid", VMAppleCfgState, cfg.ecid, 0),
     DEFINE_PROP_UINT64("ram-size", VMAppleCfgState, cfg.ram_size, 0),
