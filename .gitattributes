# Normalize first-party text, retaining upstream binary and shell policies.
* text=auto
*.kext binary
*.dmg binary
*.pkg binary
*.icns binary
*.png binary
*.jpg binary
*.sh text eol=lf
*.command text eol=lf

# Mellow manifests describe exact delivered bytes on every host.
payloads/Mellow/** -text
docs/validation/mellow-20260906/** -text -whitespace
vendor/mellow/** linguist-vendored
# Exported patches and historical evidence have byte-identity receipts.
integration/patches/*.patch -text -whitespace
research/venfire/** -text -whitespace
sandbox/vsk/crypto/** -text -whitespace

# Pre-commit guard template must stay LF (CRLF breaks hook execution)
Tools/git/hooks/pre-commit text eol=lf

# Firmware UART evidence preserves original CRLF bytes.
nextcore/artifacts/arm-efi-20260908/**/serial.log -text -whitespace
nextcore/artifacts/arm-startup-continuation-20260908/**/serial.log -text -whitespace
nextcore/artifacts/integration-bp26-20260908/*.log -text -whitespace

nextcore/artifacts/arm-platform-profile-20260908/**/*.log -text -whitespace
nextcore/artifacts/integration-bp27-20260908/**/*.log -text -whitespace

docs/validation/windows-app-cleanup-20260908/** -text -whitespace

