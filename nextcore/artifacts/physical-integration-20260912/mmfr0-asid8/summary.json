{
  "schema": "nextcore.mmfr0-asid8-evidence.v1",
  "packaging_complete": true,
  "pending": [],
  "completed_evidence_passed": true,
  "contract": "Exact MMFR0 0x0f100005 and immutable 8-bit ASID tags selected by TCR.A1; TCR.AS and upper ASID bits remain rejected.",
  "native_scope": "ASID r4 directly observes actual canonical MMU tags for profiles 1/3, both granules, A1 selections and VA halves, cold/warm translations; compiled force-zero, ignored-A1 and VA-based-tag mutants fail. 35 provider tests in each of three cache modes and 102 reference tests pass.",
  "efi_scope": "Authored current EFI executes all 64 cases with nine retired instructions and two completed data operations per case, returns TTBR/TCR and MMFR0 values. Old same-fixture binary rejects before any case completes. EFI readback is distinct from native internal-ASID observation.",
  "history": [
    "MMFR0 r1 had an incorrect expectation for an already known MSR; r2 corrects the test and passes. Failed r1 logs remain here; no production failure inferred.",
    "ASID r3 is superseded by r4 which explicitly covers profiles 1 and 3. Earlier scratch captures remain outside this package.",
    "The earlier paired EFI build receipt includes the ASID r3 test-file hash. Final native r4 explicitly covers both profiles; final pinned rebuild proves both already tested EFI binaries byte-identical after binding the final ISE commit. Historical receipts are preserved unchanged."
  ],
  "original_images_used": false,
  "physical_boot_verified": false,
  "macos_boot_verified": false,
