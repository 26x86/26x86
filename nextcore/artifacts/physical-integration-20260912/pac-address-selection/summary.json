{
  "schema": "nextcore.pac-address-selection.v1",
  "passed": true,
  "contract": "TBI-disabled APA1 signing selects address size with bit63; authentication and stripping retain bit55.",
  "oracle": "Explicitly adapted control on a test-only APA1 QEMU model; original direct baseline/test observations retained, including the shared QEMU selector defect.",
  "source_boundary": "Authored inputs and public runtime sources only. Arm PDF and extracted copyrighted text excluded.",
  "limitation": "48 adapted vectors validate address placement and 288 direct FFI outcomes. Immutable mapped address PAC is disabled; its separate regression exercises disabled PAC and active XPAC. Cipher and physical boot are not established by these checks.",
