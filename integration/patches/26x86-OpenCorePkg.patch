diff --git a/Utilities/SandboxConfigTest/SandboxConfigTest.c b/Utilities/SandboxConfigTest/SandboxConfigTest.c
new file mode 100644
index 0000000..3b4d4ed
--- /dev/null
+++ b/Utilities/SandboxConfigTest/SandboxConfigTest.c
@@ -0,0 +1,54 @@
+/** SPDX-License-Identifier: BSD-3-Clause
+  Exercise the firmware parser and serializer using synthetic configuration.
+**/
+#include <Library/OcSandboxBoot.h>
+#include <Library/MemoryAllocationLib.h>
+#include <UserFile.h>
+#include <stdio.h>
+
+int
+ENTRY_POINT (
+  int   Argc,
+  char  *Argv[]
+  )
+{
+  UINT8             *Buffer;
+  UINT32            Size;
+  UINT32            Errors;
+  OC_GLOBAL_CONFIG  Config;
+  EFI_STATUS        Status;
+  CHAR8             *Smbios;
+  CHAR8             *Devices;
+
+  if (Argc != 2) {
+    return 2;
+  }
+
+  Buffer = UserReadFile (Argv[1], &Size);
+  if (Buffer == NULL) {
+    return 2;
+  }
+
+  Errors = 0;
+  Status = OcConfigurationInit (&Config, Buffer, Size, &Errors);
+  FreePool (Buffer);
+  if (EFI_ERROR (Status)) {
+    return 3;
+  }
+
+  if (Errors != 0) {
+    OcConfigurationFree (&Config);
+    return 3;
+  }
+
+  Status = OcSandboxConfigSerialize (&Config, &Smbios, &Devices);
+  OcConfigurationFree (&Config);
+  if (EFI_ERROR (Status)) {
+    return 4;
+  }
+
+  printf ("%s\n%s\n", Smbios, Devices);
+  FreePool (Smbios);
+  FreePool (Devices);
+  return 0;
+}
