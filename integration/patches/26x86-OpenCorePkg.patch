@@ -0,0 +1,16 @@
+/** SPDX-License-Identifier: BSD-3-Clause */
+#ifndef OC_SANDBOX_CONFIG_INTERNAL_H
+#define OC_SANDBOX_CONFIG_INTERNAL_H
+#include <Library/OcConfigurationLib.h>
+
+VOID OcSandboxParseBlob (VOID *Serialized, XML_NODE *Node, OC_SCHEMA_INFO *Info, CONST CHAR8 *Context, UINT32 *ErrorCount);
+VOID OcSandboxParseInteger (VOID *Serialized, XML_NODE *Node, OC_SCHEMA_INFO *Info, CONST CHAR8 *Context, UINT32 *ErrorCount);
+VOID OcSandboxParseMap (VOID *Serialized, XML_NODE *Node, OC_SCHEMA_INFO *Info, CONST CHAR8 *Context, UINT32 *ErrorCount);
+
+#define SB_STRING(Name, Member) \
+  {Name, PLIST_NODE_TYPE_STRING, FALSE, OcSandboxParseBlob, {.Blob = {OFFSET_OF (OC_GLOBAL_CONFIG, Member), OC_SCHEMA_BLOB_STRING}}}
+#define SB_INTEGER(Name, Member) \
+  {Name, PLIST_NODE_TYPE_INTEGER, FALSE, OcSandboxParseInteger, {.Value = {OFFSET_OF (OC_GLOBAL_CONFIG, Member), sizeof (UINT32), OC_SCHEMA_VALUE_INTEGER}}}
+#define SB_MAP(Name, Offset, Child) \
+  {Name, PLIST_NODE_TYPE_DICT, FALSE, OcSandboxParseMap, {.List = {Offset, Child}}}
+#endif
