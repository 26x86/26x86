diff --git a/Library/OcMainLib/OpenCoreSandbox.c b/Library/OcMainLib/OpenCoreSandbox.c
new file mode 100644
index 0000000..ef50420
--- /dev/null
+++ b/Library/OcMainLib/OpenCoreSandbox.c
@@ -0,0 +1,212 @@
+/** @file
+  Native EFI Sandbox selection and versioned engine handoff.
+  SPDX-License-Identifier: BSD-3-Clause
+**/
+#include <Guid/FileInfo.h>
+#include <Protocol/LoadedImage.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/DevicePathLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/OcSandboxBoot.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+STATIC
+EFI_STATUS
+CheckIBootFile (
+  IN EFI_SIMPLE_FILE_SYSTEM_PROTOCOL  *FileSystem,
+  IN CHAR16                          *Path
+  )
+{
+  EFI_STATUS         Status;
+  EFI_FILE_PROTOCOL  *Root;
+  EFI_FILE_PROTOCOL  *File;
+  EFI_FILE_INFO      *Info;
+  UINTN              InfoSize;
+
+  Root = NULL;
+  File = NULL;
+  Info = NULL;
+  Status = FileSystem->OpenVolume (FileSystem, &Root);
+  if (EFI_ERROR (Status)) {
+    goto Cleanup;
+  }
+
+  Status = Root->Open (Root, &File, Path, EFI_FILE_MODE_READ, 0);
+  if (EFI_ERROR (Status)) {
+    goto Cleanup;
+  }
+
+  InfoSize = 0;
+  Status = File->GetInfo (File, &gEfiFileInfoGuid, &InfoSize, NULL);
+  if ((Status != EFI_BUFFER_TOO_SMALL) || (InfoSize < SIZE_OF_EFI_FILE_INFO) || (InfoSize > 4096)) {
+    Status = EFI_UNSUPPORTED;
+    goto Cleanup;
+  }
+
+  Info = AllocatePool (InfoSize);
+  if (Info == NULL) {
+    Status = EFI_OUT_OF_RESOURCES;
+    goto Cleanup;
+  }
+
+  Status = File->GetInfo (File, &gEfiFileInfoGuid, &InfoSize, Info);
+  if (!EFI_ERROR (Status) && (((Info->Attribute & EFI_FILE_DIRECTORY) != 0) || (Info->FileSize == 0))) {
+    Status = EFI_UNSUPPORTED;
+  }
+
+Cleanup:
+  if (Info != NULL) {
+    FreePool (Info);
+  }
+
+  if (File != NULL) {
+    File->Close (File);
+  }
+
+  if (Root != NULL) {
+    Root->Close (Root);
+  }
+
+  return Status;
+}
+
+EFI_STATUS
+OcSandboxBoot (
+  IN OC_STORAGE_CONTEXT  *Storage,
+  IN OC_GLOBAL_CONFIG    *Config
+  )
+{
+  EFI_STATUS                 Status;
+  CONST CHAR8                *Reason;
+  CHAR16                     EnginePath[OC_SANDBOX_PATH_MAX];
+  CHAR16                     IBootPath[OC_SANDBOX_PATH_MAX];
+  CHAR8                      *SmbiosXml;
+  CHAR8                      *DevicePropertiesXml;
+  EFI_DEVICE_PATH_PROTOCOL   *DevicePath;
+  EFI_LOADED_IMAGE_PROTOCOL  *LoadedImage;
+  EFI_HANDLE                 EngineImage;
+  OC_SANDBOX_HANDOFF         Handoff;
+  UINTN                      ExitDataSize;
+  CHAR16                     *ExitData;
+  BOOLEAN                    Started;
+  CONST CHAR8                *FailureAction;
+
+  if ((Storage == NULL) || (Config == NULL) || !Config->AppleSiliconSandbox.Enabled) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if (sizeof (UINTN) != sizeof (UINT64)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  Status = OcSandboxConfigValidate (Config, &Reason);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_WARN, "OCSB: Invalid configuration: %a\n", Reason));
+    return Status;
+  }
+
+  if ((Storage->FileSystem == NULL) || (Storage->StorageHandle == NULL)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  SmbiosXml           = NULL;
+  DevicePropertiesXml = NULL;
+  DevicePath          = NULL;
+  EngineImage         = NULL;
+  ExitData            = NULL;
+  ExitDataSize        = 0;
+  Started             = FALSE;
+  FailureAction       = "initialization";
+  ZeroMem (&Handoff, sizeof (Handoff));
+
+  AsciiStrToUnicodeStrS (OC_BLOB_GET (&Config->AppleSiliconSandbox.EnginePath), EnginePath, ARRAY_SIZE (EnginePath));
+  AsciiStrToUnicodeStrS (OC_BLOB_GET (&Config->AppleSiliconSandbox.IBootPath), IBootPath, ARRAY_SIZE (IBootPath));
+  Status = CheckIBootFile (Storage->FileSystem, IBootPath);
+  if (EFI_ERROR (Status)) {
+    FailureAction = "Original iBoot input unavailable";
+    goto Cleanup;
+  }
+
+  Status = OcSandboxConfigSerialize (Config, &SmbiosXml, &DevicePropertiesXml);
+  if (EFI_ERROR (Status)) {
+    FailureAction = "Configuration serialization failed";
+    goto Cleanup;
+  }
+
+  DevicePath = FileDevicePath (Storage->StorageHandle, EnginePath);
+  if (DevicePath == NULL) {
+    Status = EFI_OUT_OF_RESOURCES;
+    goto Cleanup;
+  }
+
+  // Firmware image authentication remains on the normal LoadImage path.
+  Status = gBS->LoadImage (FALSE, gImageHandle, DevicePath, NULL, 0, &EngineImage);
+  if (EFI_ERROR (Status)) {
+    FailureAction = "LoadImage failed";
+    goto Cleanup;
+  }
+
+  Status = gBS->HandleProtocol (EngineImage, &gEfiLoadedImageProtocolGuid, (VOID **)&LoadedImage);
+  if (EFI_ERROR (Status)) {
+    goto Cleanup;
+  }
+
+  // Only an application has the lifetime required by this ABI. UEFI unloads
+  // applications when their entry point returns, including error returns.
+  if (LoadedImage->ImageCodeType != EfiLoaderCode) {
+    Status = EFI_UNSUPPORTED;
+    FailureAction = "Engine must be an EFI application";
+    goto Cleanup;
+  }
+
+  Handoff.Magic               = OC_SANDBOX_HANDOFF_MAGIC;
+  Handoff.Version             = OC_SANDBOX_HANDOFF_VERSION;
+  Handoff.Size                = sizeof (Handoff);
+  Handoff.MemoryBytes         = LShiftU64 (Config->AppleSiliconSandbox.Hardware.MemorySizeMiB, 20);
+  Handoff.CpuCount             = Config->AppleSiliconSandbox.Hardware.CPUCount;
+  Handoff.TargetMajor          = Config->AppleSiliconSandbox.TargetMajor;
+  Handoff.IBootPath            = (UINT64)(UINTN)IBootPath;
+  Handoff.SmbiosXml            = (UINT64)(UINTN)SmbiosXml;
+  Handoff.DevicePropertiesXml  = (UINT64)(UINTN)DevicePropertiesXml;
+  LoadedImage->LoadOptions     = &Handoff;
+  LoadedImage->LoadOptionsSize = sizeof (Handoff);
+
+  DEBUG ((DEBUG_INFO, "OCSB: StartImage ABI v1 size=64 target=%u AIC iBoot\n", Handoff.TargetMajor));
+  Started = TRUE;
+  Status = gBS->StartImage (EngineImage, &ExitDataSize, &ExitData);
+  // StartImage may have unloaded the image; do not dereference LoadedImage here.
+  EngineImage = NULL;
+
+Cleanup:
+  if (EngineImage != NULL) {
+    gBS->UnloadImage (EngineImage);
+  }
+
+  if (ExitData != NULL) {
+    FreePool (ExitData);
+  }
+
+  if (DevicePath != NULL) {
+    FreePool (DevicePath);
+  }
+
+  if (SmbiosXml != NULL) {
+    FreePool (SmbiosXml);
+  }
+
+  if (DevicePropertiesXml != NULL) {
+    FreePool (DevicePropertiesXml);
+  }
+
+  // Logging can halt under a configured HaltLevel. Release storage first.
+  DEBUG ((DEBUG_INFO, "OCSB: Handoff storage released\n"));
+  if (Started) {
+    DEBUG ((DEBUG_WARN, "OCSB: StartImage returned - %r (no guest boot completion claimed)\n", Status));
+  } else {
+    DEBUG ((DEBUG_WARN, "OCSB: %a - %r\n", FailureAction, Status));
+  }
+
+  return Status;
+}
diff --git a/Tests/NativeSourceAudit.py b/Tests/NativeSourceAudit.py
new file mode 100644
index 0000000..d70271d
--- /dev/null
+++ b/Tests/NativeSourceAudit.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Bind an actual native build to this modified source tree before handoff tests.
+SPDX-License-Identifier: BSD-3-Clause
+"""
+import argparse
+import hashlib
+import json
+import pathlib
+import subprocess
+
+CRITICAL = (
+    "Application/OpenCore/OpenCore.c",
+    "Library/OcConfigurationLib/OcConfigurationLib.c",
+    "Library/OcConfigurationLib/SandboxConfig.c",
+    "Library/OcMainLib/OpenCoreSandbox.c",
+    "Include/Acidanthera/Library/OcConfigurationLib.h",
+    "Include/Acidanthera/Library/OcSandboxBoot.h",
+)
+MARKERS = (b"AppleSiliconSandbox", b"SandboxSMBIOS", b"OCSB: StartImage ABI v1 size=64", b"OCSB: Handoff storage released")
+
+
+def sha256(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--native-package", type=pathlib.Path, required=True)
+    parser.add_argument("--build-log", type=pathlib.Path, required=True)
+    parser.add_argument("--binary", type=pathlib.Path, required=True)
+    parser.add_argument("--output", type=pathlib.Path, required=True)
+    args = parser.parse_args()
+    source = pathlib.Path(__file__).resolve().parents[1]
+    native = args.native_package
+    log = args.build_log.read_text()
+    assert native.resolve() == source, (native.resolve(), source)
+    critical = {}
+    for relative in CRITICAL:
+        expected = source / relative
+        compiled = native / relative
+        assert compiled.resolve() == expected.resolve(), relative
+        assert sha256(compiled) == sha256(expected), relative
+        if relative.endswith(".c"):
+            assert str(compiled) in log, f"Compiler command missing for {relative}"
+        critical[relative] = sha256(expected)
+
+    binary = args.binary.read_bytes()
+    found = {marker.decode(): marker in binary for marker in MARKERS}
+    assert all(found.values()), f"Wrong EFI or missing Sandbox code: {found}"
+    files = subprocess.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=source).decode().split("\0")
+    suffixes = {".c", ".h", ".inf", ".dsc", ".dec", ".nasm", ".asm", ".S", ".inc", ".fdf"}
+    sources = {relative: sha256(source / relative) for relative in sorted(set(files)) if relative and (source / relative).suffix in suffixes}
+    report = {
+        "schema": 1,
+        "source_baseline": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=source, text=True).strip(),
+        "source_root": str(source), "native_package": str(native),
+        "native_package_resolved": str(native.resolve()),
+        "critical_source_sha256": critical,
+        "source_manifest_sha256": hashlib.sha256(json.dumps(sources, sort_keys=True).encode()).hexdigest(),
+        "source_files": sources,
+        "binary": {"size": len(binary), "sha256": hashlib.sha256(binary).hexdigest(), "markers": found},
+        "build_log_sha256": sha256(args.build_log),
+        "runtime_verified": False,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    print(f"PASS {len(sources)} source hashes, 6 critical resolved paths, 4 EFI markers; binary {report['binary']['sha256']}")
+
+
+if __name__ == "__main__":
+    main()
