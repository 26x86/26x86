@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Exercise actual native OC schema/validation/serialization. Synthetic data only.
+
+Build Utilities/ocvalidate and Utilities/SandboxConfigTest first; then run this
+script on a host capable of executing the resulting userspace tools.
+SPDX-License-Identifier: BSD-3-Clause
+"""
+import copy
+import pathlib
+import plistlib
+import subprocess
+import tempfile
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+VALIDATOR = ROOT / "Utilities/ocvalidate/ocvalidate"
+SERIALIZER = ROOT / "Utilities/SandboxConfigTest/SandboxConfigTest"
+
+
+def main():
+    sample = plistlib.loads((ROOT / "Docs/Sample.plist").read_bytes())
+    reports = []
+    with tempfile.TemporaryDirectory(prefix="26x86-oc-config-") as directory:
+        path = pathlib.Path(directory) / "config.plist"
+
+        def run(name, config, expected=True, executable=VALIDATOR):
+            path.write_bytes(plistlib.dumps(config, sort_keys=False))
+            result = subprocess.run([str(executable), str(path)], capture_output=True, timeout=30)
+            assert (result.returncode == 0) == expected, (name, result.returncode, result.stdout, result.stderr)
+            reports.append(name)
+            return result.stdout
+
+        run("disabled defaults", sample)
+        legacy = copy.deepcopy(sample)
+        del legacy["AppleSiliconSandbox"]
+        del legacy["SandboxSMBIOS"]
+        run("legacy configuration remains valid", legacy)
+        custom = plistlib.loads((ROOT / "Docs/SampleCustom.plist").read_bytes())
+        run("custom sample", custom)
+        enabled = copy.deepcopy(sample)
+        enabled["AppleSiliconSandbox"].update(Enabled=True, IBootPath="\\EFI\\26x86\\fixtures\\iboot.img4")
+        enabled["SandboxSMBIOS"] = {
+            "SystemProductName": "Synthetic&<Model>",
+            "SystemSerialNumber": "TEST-ONLY",
+            "SystemUUID": "00112233-4455-6677-8899-aabbccddeeff",
+            "BoardProduct": "Synthetic'\"Board",
+        }
+        values = {"zero": b"", "one": b"\xff", "two": b"\x00\xff", "three": b"\x00\x80\xff", "four": b"abcd", "truth": True, "false": False, "text": "abc&<tag>", "small": 7, "large": (1 << 64) - 1}
+        enabled["AppleSiliconSandbox"]["Hardware"]["DeviceProperties"] = {"synthetic&device": values}
+        run("enabled schema", enabled)
+        output = run("native serialization", enabled, executable=SERIALIZER)
+        start = output.index(b"<?xml")
+        documents = output[start:].splitlines()
+        assert len(documents) == 2, documents
+        assert plistlib.loads(documents[0]) == enabled["SandboxSMBIOS"]
+        props = plistlib.loads(documents[1])["synthetic&device"]
+        for name, value in values.items():
+            if isinstance(value, bool):
+                assert props[name] == bytes([value])
+            elif isinstance(value, int):
+                assert int.from_bytes(props[name], "little") == value
+            elif isinstance(value, str):
+                assert props[name] == value.encode() + b"\0"
+            else:
+                assert props[name] == value
+
+        cases = [
+            ("GIC rejected", ("AppleSiliconSandbox", "InterruptController"), "GIC"),
+            ("UEFI guest rejected", ("AppleSiliconSandbox", "BootProtocol"), "UEFI"),
+            ("unknown target rejected", ("AppleSiliconSandbox", "TargetMajor"), 28),
+            ("wrapped uint32 target rejected", ("AppleSiliconSandbox", "TargetMajor"), (1 << 32) + 26),
+            ("small RAM rejected", ("AppleSiliconSandbox", "Hardware", "MemorySizeMiB"), 4095),
+            ("large RAM rejected", ("AppleSiliconSandbox", "Hardware", "MemorySizeMiB"), 1048577),
+            ("zero CPU rejected", ("AppleSiliconSandbox", "Hardware", "CPUCount"), 0),
+            ("large CPU rejected", ("AppleSiliconSandbox", "Hardware", "CPUCount"), 65),
+            ("wrong type rejected", ("AppleSiliconSandbox", "Enabled"), "true"),
+            ("absent original path rejected", ("AppleSiliconSandbox", "IBootPath"), ""),
+            ("path traversal rejected", ("AppleSiliconSandbox", "IBootPath"), "\\EFI\\..\\iboot"),
+            ("path drive rejected", ("AppleSiliconSandbox", "IBootPath"), "C:\\iboot"),
+            ("long path rejected", ("AppleSiliconSandbox", "IBootPath"), "\\" + "x" * 191),
+            ("empty identity rejected", ("SandboxSMBIOS", "BoardProduct"), ""),
+            ("malformed UUID rejected", ("SandboxSMBIOS", "SystemUUID"), "0" * 36),
+            ("negative device integer rejected", ("AppleSiliconSandbox", "Hardware", "DeviceProperties", "synthetic&device", "small"), -1),
+        ]
+        for name, keys, value in cases:
+            invalid = copy.deepcopy(enabled)
+            current = invalid
+            for key in keys[:-1]:
+                current = current[key]
+            current[keys[-1]] = value
+            run(name, invalid, False)
+        huge = copy.deepcopy(enabled)
+        huge["AppleSiliconSandbox"]["Hardware"]["DeviceProperties"] = {"device": {"blob": b"a" * 800000}}
+        run("serialized XML limit rejected", huge, False, SERIALIZER)
+        excessive = copy.deepcopy(enabled)
+        excessive["AppleSiliconSandbox"]["Hardware"]["DeviceProperties"] = {"device": {f"property-{index}": b"x" for index in range(4097)}}
+        run("map allocation count limit rejected", excessive, False)
+    print(f"PASS {len(reports)} native configuration cases; XML/base64 round-trip and ABI static assertions verified")
+
+
+if __name__ == "__main__":
+    main()
