new file mode 100644
index 0000000..de83622
--- /dev/null
+++ b/Library/OcConfigurationLib/SandboxConfig.c
@@ -0,0 +1,590 @@
+/** @file
+  Guest-only Sandbox validation and bounded serialization.
+  SPDX-License-Identifier: BSD-3-Clause
+**/
+#include <Library/OcSandboxBoot.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include "SandboxConfig.h"
+
+STATIC
+BOOLEAN
+UnsignedDecimal (
+  IN  CONST CHAR8  *Text,
+  OUT UINT64       *Value
+  )
+{
+  UINT64  Number;
+  UINT32  Digit;
+
+  if ((Text == NULL) || (*Text == '\0')) {
+    return FALSE;
+  }
+
+  Number = 0;
+  while (*Text != '\0') {
+    if ((*Text < '0') || (*Text > '9')) {
+      return FALSE;
+    }
+
+    Digit = (UINT32)(*Text++ - '0');
+    if (Number > DivU64x32 (MAX_UINT64 - Digit, 10)) {
+      return FALSE;
+    }
+
+    Number = MultU64x32 (Number, 10) + Digit;
+  }
+
+  *Value = Number;
+  return TRUE;
+}
+
+// OpenCore's generic strings retain XML entities. Decode only Sandbox values;
+// never reinterpret a <data> payload as text. Unsupported entities fail closed.
+STATIC
+CONST CHAR8 *
+DecodeText (
+  IN CONST CHAR8  *Text
+  )
+{
+  CONST CHAR8  *Cursor;
+
+  if (Text == NULL) {
+    Text = "";
+  }
+
+  for (Cursor = Text; *Cursor != '\0'; ++Cursor) {
+    if ((*Cursor == '&')
+      && (AsciiStrnCmp (Cursor, "&amp;", 5) != 0)
+      && (AsciiStrnCmp (Cursor, "&lt;", 4) != 0)
+      && (AsciiStrnCmp (Cursor, "&gt;", 4) != 0)
+      && (AsciiStrnCmp (Cursor, "&quot;", 6) != 0)
+      && (AsciiStrnCmp (Cursor, "&apos;", 6) != 0))
+    {
+      return NULL;
+    }
+  }
+
+  return XmlUnescapeString (Text);
+}
+
+VOID
+OcSandboxParseBlob (
+  VOID            *Serialized,
+  XML_NODE        *Node,
+  OC_SCHEMA_INFO  *Info,
+  CONST CHAR8     *Context,
+  UINT32          *ErrorCount
+  )
+{
+  CONST CHAR8  *Decoded;
+  VOID         *Field;
+  VOID         *Buffer;
+  UINT32       *BlobSize;
+  UINT32       Size;
+  UINT64       Number;
+
+  Field = OC_SCHEMA_FIELD (Serialized, VOID, Info->Blob.Field);
+  if (PlistNodeCast (Node, PLIST_NODE_TYPE_STRING) != NULL) {
+    Decoded = DecodeText (XmlNodeContent (Node));
+    if (Decoded == NULL) {
+      goto Failure;
+    }
+
+    Size = (UINT32)AsciiStrSize (Decoded);
+    Buffer = OcBlobAllocate (Field, Size, &BlobSize);
+    if (Buffer != NULL) {
+      CopyMem (Buffer, Decoded, Size);
+      *BlobSize = Size;
+    }
+
+    FreePool ((VOID *)Decoded);
+    if (Buffer == NULL) {
+      goto Failure;
+    }
+
+    return;
+  }
+
+  if ((Info->Blob.Type == OC_SCHEMA_BLOB_MDATA) && (PlistNodeCast (Node, PLIST_NODE_TYPE_INTEGER) != NULL)) {
+    if (!UnsignedDecimal (XmlNodeContent (Node), &Number)) {
+      goto Failure;
+    }
+
+    Size = Number <= MAX_UINT32 ? sizeof (UINT32) : sizeof (UINT64);
+    Buffer = OcBlobAllocate (Field, Size, &BlobSize);
+    if (Buffer == NULL) {
+      goto Failure;
+    }
+
+    CopyMem (Buffer, &Number, Size);
+    *BlobSize = Size;
+    return;
+  }
+
+  ParseSerializedBlob (Serialized, Node, Info, Context, ErrorCount);
+  return;
+
+Failure:
+  if (ErrorCount != NULL) {
+    ++*ErrorCount;
+  }
+}
+
+VOID
+OcSandboxParseInteger (
+  VOID            *Serialized,
+  XML_NODE        *Node,
+  OC_SCHEMA_INFO  *Info,
+  CONST CHAR8     *Context,
+  UINT32          *ErrorCount
+  )
+{
+  UINT64  Number;
+
+  if ((PlistNodeCast (Node, PLIST_NODE_TYPE_INTEGER) == NULL)
+    || !UnsignedDecimal (XmlNodeContent (Node), &Number) || (Number > MAX_UINT32))
+  {
+    if (ErrorCount != NULL) {
+      ++*ErrorCount;
+    }
+
+    return;
+  }
+
+  *OC_SCHEMA_FIELD (Serialized, UINT32, Info->Value.Field) = (UINT32)Number;
+}
+
+VOID
+OcSandboxParseMap (
+  VOID            *Serialized,
+  XML_NODE        *Node,
+  OC_SCHEMA_INFO  *Info,
+  CONST CHAR8     *Context,
+  UINT32          *ErrorCount
+  )
+{
+  OC_ASSOC     *Map;
+  UINT32       Index;
+  UINT32       Other;
+  UINT32       Size;
+  UINT32       *BlobSize;
+  VOID         *Buffer;
+  CONST CHAR8  *Decoded;
+
+  if (PlistDictChildren (Node) > 4096) {
+    if (ErrorCount != NULL) {
+      ++*ErrorCount;
+    }
+
+    return;
+  }
+
+  ParseSerializedMap (Serialized, Node, Info, Context, ErrorCount);
+  Map = OC_SCHEMA_FIELD (Serialized, OC_ASSOC, Info->List.Field);
+  for (Index = 0; Index < Map->Count; ++Index) {
+    Decoded = DecodeText (OC_BLOB_GET (Map->Keys[Index]));
+    if (Decoded == NULL) {
+      if (ErrorCount != NULL) {
+        ++*ErrorCount;
+      }
+
+      continue;
+    }
+
+    Size = (UINT32)AsciiStrSize (Decoded);
+    Buffer = OcBlobAllocate (Map->Keys[Index], Size, &BlobSize);
+    if (Buffer != NULL) {
+      CopyMem (Buffer, Decoded, Size);
+      *BlobSize = Size;
+    } else if (ErrorCount != NULL) {
+      ++*ErrorCount;
+    }
+
+    FreePool ((VOID *)Decoded);
+    for (Other = 0; Other < Index; ++Other) {
+      if ((AsciiStrCmp (OC_BLOB_GET (Map->Keys[Index]), OC_BLOB_GET (Map->Keys[Other])) == 0) && (ErrorCount != NULL)) {
+        ++*ErrorCount;
+      }
+    }
+  }
+}
+
+STATIC
+BOOLEAN
+SafeText (
+  IN OC_STRING  *String,
+  IN UINTN      Maximum,
+  IN BOOLEAN    Required
+  )
+{
+  CONST CHAR8  *Text;
+  UINTN        Length;
+  UINTN        Index;
+
+  Text   = OC_BLOB_GET (String);
+  Length = AsciiStrLen (Text);
+  if ((Length > Maximum) || (Required && (Length == 0))) {
+    return FALSE;
+  }
+
+  for (Index = 0; Index < Length; ++Index) {
+    if (((UINT8)Text[Index] < 0x20) || ((UINT8)Text[Index] > 0x7E)) {
+      return FALSE;
+    }
+  }
+
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+SafePath (
+  IN OC_STRING  *String,
+  IN BOOLEAN    Required
+  )
+{
+  CONST CHAR8  *Text;
+  CONST CHAR8  *Part;
+  UINTN        Index;
+
+  if (!SafeText (String, OC_SANDBOX_PATH_MAX - 1, Required)) {
+    return FALSE;
+  }
+
+  Text = OC_BLOB_GET (String);
+  if (Text[0] == '\0') {
+    return !Required;
+  }
+
+  if ((Text[0] != '\\') || (Text[1] == '\0')) {
+    return FALSE;
+  }
+
+  Part = Text + 1;
+  for (Index = 1; ; ++Index) {
+    if ((Text[Index] == '/') || (Text[Index] == ':')) {
+      return FALSE;
+    }
+
+    if ((Text[Index] == '\\') || (Text[Index] == '\0')) {
+      if ((Text + Index == Part)
+        || ((Text + Index - Part == 1) && (Part[0] == '.'))
+        || ((Text + Index - Part == 2) && (Part[0] == '.') && (Part[1] == '.')))
+      {
+        return FALSE;
+      }
+
+      Part = Text + Index + 1;
+    }
+
+    if (Text[Index] == '\0') {
+      break;
+    }
+  }
+
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+ValidUuid (
+  IN CONST CHAR8  *Text
+  )
+{
+  UINTN  Index;
+  CHAR8  Ch;
+
+  if (AsciiStrLen (Text) != 36) {
+    return FALSE;
+  }
+
+  for (Index = 0; Index < 36; ++Index) {
+    Ch = Text[Index];
+    if ((Index == 8) || (Index == 13) || (Index == 18) || (Index == 23)) {
+      if (Ch != '-') {
+        return FALSE;
+      }
+    } else if (!(((Ch >= '0') && (Ch <= '9')) || ((Ch >= 'a') && (Ch <= 'f')) || ((Ch >= 'A') && (Ch <= 'F')))) {
+      return FALSE;
+    }
+  }
+
+  return TRUE;
+}
+
+EFI_STATUS
+OcSandboxConfigValidate (
+  IN  OC_GLOBAL_CONFIG  *Config,
+  OUT CONST CHAR8       **Reason
+  )
+{
+  OC_SANDBOX_CONFIG    *Sandbox;
+  OC_SANDBOX_SMBIOS    *Smbios;
+  OC_DEV_PROP_ADD_MAP  *Devices;
+  OC_ASSOC            *Properties;
+  UINT32              Device;
+  UINT32              Property;
+
+  if ((Config == NULL) || (Reason == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  Sandbox = &Config->AppleSiliconSandbox;
+  Smbios  = &Config->SandboxSMBIOS;
+  *Reason = "AIC and iBoot are the only supported version 1 protocols";
+  if ((AsciiStrCmp (OC_BLOB_GET (&Sandbox->InterruptController), "AIC") != 0)
+    || (AsciiStrCmp (OC_BLOB_GET (&Sandbox->BootProtocol), "iBoot") != 0))
+  {
+    return EFI_UNSUPPORTED;
+  }
+
+  *Reason = "TargetMajor must be 26 or 27";
+  if ((Sandbox->TargetMajor != 26) && (Sandbox->TargetMajor != 27)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  *Reason = "MemorySizeMiB must be 4096..1048576 and CPUCount must be 1..64";
+  if ((Sandbox->Hardware.MemorySizeMiB < 4096) || (Sandbox->Hardware.MemorySizeMiB > 1048576)
+    || (Sandbox->Hardware.CPUCount < 1) || (Sandbox->Hardware.CPUCount > 64))
+  {
+    return EFI_UNSUPPORTED;
+  }
+
+  *Reason = "EnginePath and enabled IBootPath require canonical absolute ASCII EFI paths, at most 191 characters";
+  if (!SafePath (&Sandbox->EnginePath, TRUE) || !SafePath (&Sandbox->IBootPath, Sandbox->Enabled)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  *Reason = "SandboxSMBIOS strings must be printable ASCII, at most 255 characters, and nonempty when enabled";
+  if (!SafeText (&Smbios->SystemProductName, 255, Sandbox->Enabled)
+    || !SafeText (&Smbios->SystemSerialNumber, 255, Sandbox->Enabled)
+    || !SafeText (&Smbios->BoardProduct, 255, Sandbox->Enabled)
+    || !SafeText (&Smbios->SystemUUID, 36, Sandbox->Enabled))
+  {
+    return EFI_UNSUPPORTED;
+  }
+
+  *Reason = "SandboxSMBIOS SystemUUID must use the canonical 8-4-4-4-12 hexadecimal format";
+  if ((OC_BLOB_GET (&Smbios->SystemUUID)[0] != '\0') && !ValidUuid (OC_BLOB_GET (&Smbios->SystemUUID))) {
+    return EFI_UNSUPPORTED;
+  }
+
+  *Reason = "DeviceProperties requires nonempty ASCII keys (at most 255 characters), at most 4096 entries per map and at most 1 MiB per data value";
+  Devices = &Sandbox->Hardware.DeviceProperties;
+  if (Devices->Count > 4096) {
+    return EFI_UNSUPPORTED;
+  }
+
+  for (Device = 0; Device < Devices->Count; ++Device) {
+    Properties = Devices->Values[Device];
+    if (!SafeText (Devices->Keys[Device], 255, TRUE) || (Properties->Count > 4096)) {
+      return EFI_UNSUPPORTED;
+    }
+
+    for (Property = 0; Property < Properties->Count; ++Property) {
+      if (!SafeText (Properties->Keys[Property], 255, TRUE) || (Properties->Values[Property]->Size > OC_SANDBOX_XML_MAX)) {
+        return EFI_UNSUPPORTED;
+      }
+    }
+  }
+
+  *Reason = "valid";
+  return EFI_SUCCESS;
+}
+
+typedef struct {
+  CHAR8    *Buffer;
+  UINTN    Length;
+  BOOLEAN  Failed;
+} XML_WRITER;
+
+STATIC
+VOID
+Append (
+  IN OUT XML_WRITER  *Writer,
+  IN     CONST CHAR8 *Text
+  )
+{
+  UINTN  Size;
+
+  Size = AsciiStrLen (Text);
+  if (Writer->Failed || (Size >= OC_SANDBOX_XML_MAX - Writer->Length)) {
+    Writer->Failed = TRUE;
+    return;
+  }
+
+  CopyMem (Writer->Buffer + Writer->Length, Text, Size + 1);
+  Writer->Length += Size;
+}
+
+STATIC
+VOID
+Escape (
+  IN OUT XML_WRITER  *Writer,
+  IN     CONST CHAR8 *Text
+  )
+{
+  CHAR8  Single[2];
+
+  Single[1] = '\0';
+  while (*Text != '\0') {
+    switch (*Text) {
+      case '&': Append (Writer, "&amp;"); break;
+      case '<': Append (Writer, "&lt;"); break;
+      case '>': Append (Writer, "&gt;"); break;
+      case '"': Append (Writer, "&quot;"); break;
+      case '\'': Append (Writer, "&apos;"); break;
+      default:
+        Single[0] = *Text;
+        Append (Writer, Single);
+        break;
+    }
+
+    ++Text;
+  }
+}
+
+STATIC
+VOID
+Key (
+  IN OUT XML_WRITER  *Writer,
+  IN     CONST CHAR8 *Text
+  )
+{
+  Append (Writer, "<key>");
+  Escape (Writer, Text);
+  Append (Writer, "</key>");
+}
+
+STATIC
+VOID
+StringPair (
+  IN OUT XML_WRITER  *Writer,
+  IN     CONST CHAR8 *Name,
+  IN     OC_STRING   *Value
+  )
+{
+  Key (Writer, Name);
+  Append (Writer, "<string>");
+  Escape (Writer, OC_BLOB_GET (Value));
+  Append (Writer, "</string>");
+}
+
+STATIC
+VOID
+Data (
+  IN OUT XML_WRITER  *Writer,
+  IN     OC_DATA     *Value
+  )
+{
+  STATIC CONST CHAR8  Alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  CONST UINT8        *Bytes;
+  UINT32             Index;
+  UINT32             Bits;
+  UINT32             Remaining;
+  CHAR8              Encoded[5];
+
+  Bytes      = OC_BLOB_GET (Value);
+  Encoded[4] = '\0';
+  Append (Writer, "<data>");
+  for (Index = 0; (Index < Value->Size) && !Writer->Failed; Index += 3) {
+    Remaining = Value->Size - Index;
+    Bits      = ((UINT32)Bytes[Index]) << 16;
+    if (Remaining > 1) {
+      Bits |= ((UINT32)Bytes[Index + 1]) << 8;
+    }
+
+    if (Remaining > 2) {
+      Bits |= Bytes[Index + 2];
+    }
+
+    Encoded[0] = Alphabet[(Bits >> 18) & 63];
+    Encoded[1] = Alphabet[(Bits >> 12) & 63];
+    Encoded[2] = Remaining > 1 ? Alphabet[(Bits >> 6) & 63] : '=';
+    Encoded[3] = Remaining > 2 ? Alphabet[Bits & 63] : '=';
+    Append (Writer, Encoded);
+  }
+
+  Append (Writer, "</data>");
+}
+
+EFI_STATUS
+OcSandboxConfigSerialize (
+  IN  OC_GLOBAL_CONFIG  *Config,
+  OUT CHAR8             **SmbiosXml,
+  OUT CHAR8             **DevicePropertiesXml
+  )
+{
+  EFI_STATUS          Status;
+  CONST CHAR8         *Reason;
+  XML_WRITER          Smbios;
+  XML_WRITER          Devices;
+  OC_DEV_PROP_ADD_MAP  *Map;
+  OC_ASSOC            *Properties;
+  UINT32              Device;
+  UINT32              Property;
+
+  if ((SmbiosXml == NULL) || (DevicePropertiesXml == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *SmbiosXml           = NULL;
+  *DevicePropertiesXml = NULL;
+  Status = OcSandboxConfigValidate (Config, &Reason);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  ZeroMem (&Smbios, sizeof (Smbios));
+  ZeroMem (&Devices, sizeof (Devices));
+  Smbios.Buffer  = AllocateZeroPool (OC_SANDBOX_XML_MAX);
+  Devices.Buffer = AllocateZeroPool (OC_SANDBOX_XML_MAX);
+  if ((Smbios.Buffer == NULL) || (Devices.Buffer == NULL)) {
+    Status = EFI_OUT_OF_RESOURCES;
+    goto Cleanup;
+  }
+
+  Append (&Smbios, "<?xml version=\"1.0\"?><plist version=\"1.0\"><dict>");
+  StringPair (&Smbios, "BoardProduct", &Config->SandboxSMBIOS.BoardProduct);
+  StringPair (&Smbios, "SystemProductName", &Config->SandboxSMBIOS.SystemProductName);
+  StringPair (&Smbios, "SystemSerialNumber", &Config->SandboxSMBIOS.SystemSerialNumber);
+  StringPair (&Smbios, "SystemUUID", &Config->SandboxSMBIOS.SystemUUID);
+  Append (&Smbios, "</dict></plist>");
+
+  Append (&Devices, "<?xml version=\"1.0\"?><plist version=\"1.0\"><dict>");
+  Map = &Config->AppleSiliconSandbox.Hardware.DeviceProperties;
+  for (Device = 0; (Device < Map->Count) && !Devices.Failed; ++Device) {
+    Key (&Devices, OC_BLOB_GET (Map->Keys[Device]));
+    Append (&Devices, "<dict>");
+    Properties = Map->Values[Device];
+    for (Property = 0; (Property < Properties->Count) && !Devices.Failed; ++Property) {
+      Key (&Devices, OC_BLOB_GET (Properties->Keys[Property]));
+      Data (&Devices, Properties->Values[Property]);
+    }
+
+    Append (&Devices, "</dict>");
+  }
+
+  Append (&Devices, "</dict></plist>");
+  if (Smbios.Failed || Devices.Failed) {
+    Status = EFI_BAD_BUFFER_SIZE;
+    goto Cleanup;
+  }
+
+  *SmbiosXml           = Smbios.Buffer;
+  *DevicePropertiesXml = Devices.Buffer;
+  return EFI_SUCCESS;
+
+Cleanup:
+  if (Smbios.Buffer != NULL) {
+    FreePool (Smbios.Buffer);
+  }
+
+  if (Devices.Buffer != NULL) {
+    FreePool (Devices.Buffer);
+  }
+
+  return Status;
+}
diff --git a/Library/OcConfigurationLib/SandboxConfig.h b/Library/OcConfigurationLib/SandboxConfig.h
