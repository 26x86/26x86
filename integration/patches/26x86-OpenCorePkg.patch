diff --git a/Include/Acidanthera/Library/OcSandboxBoot.h b/Include/Acidanthera/Library/OcSandboxBoot.h
new file mode 100644
index 0000000..9402da8
--- /dev/null
+++ b/Include/Acidanthera/Library/OcSandboxBoot.h
@@ -0,0 +1,45 @@
+/** @file
+  26x86 native Sandbox handoff. SPDX-License-Identifier: BSD-3-Clause
+**/
+#ifndef OC_SANDBOX_BOOT_H
+#define OC_SANDBOX_BOOT_H
+
+#include <Uefi.h>
+#include <Library/OcConfigurationLib.h>
+#include <Library/OcStorageLib.h>
+
+#define OC_SANDBOX_HANDOFF_MAGIC    0x3149424146583632ULL
+#define OC_SANDBOX_HANDOFF_VERSION  1U
+#define OC_SANDBOX_XML_MAX          1048576U
+#define OC_SANDBOX_PATH_MAX         192U
+
+// Wire-compatible with sandbox/efi/handoff.h. Pointers remain valid until
+// StartImage returns. Version 1 requires AIC and iBoot, with no alternative.
+typedef struct {
+  UINT64  Magic;
+  UINT32  Version;
+  UINT32  Size;
+  UINT64  Flags;
+  UINT64  MemoryBytes;
+  UINT32  CpuCount;
+  UINT32  TargetMajor;
+  UINT64  IBootPath;
+  UINT64  SmbiosXml;
+  UINT64  DevicePropertiesXml;
+} OC_SANDBOX_HANDOFF;
+
+STATIC_ASSERT (sizeof (OC_SANDBOX_HANDOFF) == 64, "Sandbox ABI size");
+STATIC_ASSERT (OFFSET_OF (OC_SANDBOX_HANDOFF, Flags) == 16, "Sandbox flags offset");
+STATIC_ASSERT (OFFSET_OF (OC_SANDBOX_HANDOFF, MemoryBytes) == 24, "Sandbox memory offset");
+STATIC_ASSERT (OFFSET_OF (OC_SANDBOX_HANDOFF, CpuCount) == 32, "Sandbox CPU offset");
+STATIC_ASSERT (OFFSET_OF (OC_SANDBOX_HANDOFF, IBootPath) == 40, "Sandbox path offset");
+STATIC_ASSERT (OFFSET_OF (OC_SANDBOX_HANDOFF, SmbiosXml) == 48, "Sandbox SMBIOS offset");
+STATIC_ASSERT (OFFSET_OF (OC_SANDBOX_HANDOFF, DevicePropertiesXml) == 56, "Sandbox DevProp offset");
+
+EFI_STATUS
+OcSandboxBoot (
+  IN OC_STORAGE_CONTEXT  *Storage,
+  IN OC_GLOBAL_CONFIG    *Config
+  );
+
+#endif
